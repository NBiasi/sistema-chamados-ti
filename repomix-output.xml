  }

  .avaliacao-emoji { font-size: 2.4rem; }
  .avaliacao-titulo { font-size: 1.15rem; }

  .avaliacao-resumo {
    grid-template-columns: 1fr;
  }

  .avaliacao-resumo .full-width {
    grid-column: span 1;
  }

  .star-btn { font-size: 2rem; }

  .avaliacao-acoes-modal {
    flex-direction: column-reverse;
  }

  .avaliacao-acoes-modal button {
    width: 100%;
  }
  
  .pagination-container {
    justify-content: center;
  }
}
