                                let somaResp = 0, countResp = 0, somaReso = 0, countReso = 0;
                                chamadosDoTecnico.forEach(c => {
                                  if(c.dataAtribuicao && c.dataAbertura) {
                                    somaResp += (new Date(c.dataAtribuicao) - new Date(c.dataAbertura));
                                    countResp++;
