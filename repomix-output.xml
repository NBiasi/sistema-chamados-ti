<file path="nginx/nginx.conf">
server {
    listen 80;
    server_name localhost chamados.colinas.to.gov.br;

    # Serve os ficheiros estáticos do React (Frontend)
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy Reverso para a API (Backend Spring Boot)
    location /api/ {
        proxy_pass http://backend:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy Reverso para os WebSockets (STOMP)
    location /ws-chamados/ {
        proxy_pass http://backend:8080/ws-chamados/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
