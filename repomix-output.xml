<file path="frontend/src/pages/DashboardVisitante/DashboardVisitante.jsx">
import React, { useState, useEffect } from 'react';
import api, { listarSecretarias, listarLocaisPorSecretaria, buscarChamadosVisitante } from '../../services/api';
import { mascararTelefone, telefoneValido, MSG_TELEFONE_INVALIDO } from '../../services/validacoes';
import { Client } from '@stomp/stompjs';
import SockJS from 'sockjs-client';
import './DashboardVisitante.css';

function DashboardVisitante({ onVoltarLogin }) {
  const [modalAberto, setModalAberto] = useState(false);
  const [nomeVisitante, setNomeVisitante] = useState('');
  const [contatoVisitante, setContatoVisitante] = useState('');
  const [secretariaId, setSecretariaId] = useState('');
  const [localId, setLocalId] = useState('');
  const [localVisitante, setLocalVisitante] = useState('');
  const [titulo, setTitulo] = useState('');
  const [categoria, setCategoria] = useState('');
  const [descricao, setDescricao] = useState('');
  const [secretariasList, setSecretariasList] = useState([]);
  const [locaisList, setLocaisList] = useState([]);
  const [meusChamados, setMeusChamados] = useState([]);
  const [carregando, setCarregando] = useState(false);
  const [sucessoMsg, setSucessoMsg] = useState('');
  const [erroMsg, setErroMsg] = useState('');
  const [erroTelefone, setErroTelefone] = useState('');

  const visitorId = (() => {
    const chave = 'visitor_session';
    const salvo = localStorage.getItem(chave);
    const agora = new Date().getTime();
    if (salvo) {
      try {
        const dados = JSON.parse(salvo);
        if (agora < dados.expiresAt) return dados.id;
      } catch (e) {}
    }
    localStorage.removeItem(chave);
    const novoId = 'vis_' + Math.random().toString(36).substring(2, 9) + Date.now().toString(36);
    const quatroHorasEmMs = 4 * 60 * 60 * 1000;
    localStorage.setItem(chave, JSON.stringify({ id: novoId, expiresAt: agora + quatroHorasEmMs }));
    return novoId;
  })();

  const carregarHistoricoVisitante = async (silencioso = false) => {
    if (!visitorId) return;
    try {
      const dados = await buscarChamadosVisitante(visitorId);
      setMeusChamados(dados);
    } catch (err) {
      console.error('Erro ao carregar chamados antigos do visitante:', err);
    }
  };

  useEffect(() => {
    carregarHistoricoVisitante();

    // Conexão WebSocket corrigida para caminho relativo (passa pelo Nginx)
    const socket = new SockJS('/ws-chamados');
    const stompClient = new Client({
      webSocketFactory: () => socket,
      reconnectDelay: 5000,
      onConnect: () => {
        stompClient.subscribe('/topic/chamados', () => {
          carregarHistoricoVisitante(true);
        });
      }
    });
    
    stompClient.activate();

    return () => stompClient.deactivate();
  }, [visitorId]);

  useEffect(() => {
    async function carregarSecretarias() {
      try {
        const dados = await listarSecretarias();
        setSecretariasList(dados);
      } catch (err) {}
    }
    carregarSecretarias();
  }, []);

  useEffect(() => {
    async function carregarLocais() {
      if (!secretariaId) {
        setLocaisList([]);
        return;
      }
      try {
        const dados = await listarLocaisPorSecretaria(secretariaId);
        setLocaisList(dados);
      } catch (err) {}
    }
    carregarLocais();
  }, [secretariaId]);

  // Acessibilidade: Fechar modal ao pressionar 'Esc'
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Escape' && modalAberto && !carregando) {
        setModalAberto(false);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [modalAberto, carregando]);

  const handleContatoChange = (e) => {
    const valorMascarado = mascararTelefone(e.target.value);
    setContatoVisitante(valorMascarado);
    if (erroTelefone) setErroTelefone('');
  };

  const handleSubmitChamado = async (e) => {
    e.preventDefault();
    setErroMsg('');
    setSucessoMsg('');
    setErroTelefone('');

    if (!telefoneValido(contatoVisitante)) {
      setErroTelefone(MSG_TELEFONE_INVALIDO);
      return;
    }

    setCarregando(true);

    const payload = {
      visitorId,
      nomeVisitante,
      contatoVisitante,
      secretariaVisitanteId: Number(secretariaId),
      localId: localId ? Number(localId) : null,
      localVisitante,
      titulo,
      categoria,
      descricao
    };

    try {
      const response = await api.post('/chamados/visitante', payload);
      const novoChamado = response.data;
      setMeusChamados([novoChamado, ...meusChamados]);
      setSucessoMsg(`Chamado aberto com sucesso! Guarde seu protocolo: ${novoChamado.protocolo}`);
      setTitulo('');
      setCategoria('');
      setDescricao('');
      setLocalVisitante('');
      setLocalId('');
      setContatoVisitante('');
      setErroTelefone('');
      setModalAberto(false);
    } catch (err) {
      setErroMsg('Erro ao abrir chamado. Verifique os dados informados.');
    } finally {
      setCarregando(false);
    }
  };

  return (
    <main className="dash-user-container" aria-label="Painel de Visitante">
      <header className="dash-user-header">
        <div className="user-branding">
          <div className="user-avatar" style={{ backgroundColor: '#475569' }} aria-hidden="true">👤</div>
          <div className="user-info">
            <h1 style={{ fontSize: '1.2rem', margin: '0' }}>Acesso sem Conta (Visitante)</h1>
            <p>Modo público de solicitação de suporte de TI<span className="badge-sec">Visitante</span></p>
          </div>
        </div>
        <button className="btn-logout" onClick={onVoltarLogin} aria-label="Fazer Login ou Sair do sistema">
          Fazer Login / Sair
        </button>
      </header>

      <div aria-live="polite" aria-atomic="true">
        {sucessoMsg && <div className="alert-success-box" role="status">{sucessoMsg}</div>}
        {erroMsg && <div className="alert-error-box" role="alert">{erroMsg}</div>}
      </div>

      <section className="action-bar" aria-label="Ações rápidas">
        <button className="btn-primary-action" onClick={() => setModalAberto(true)}>
          + Abrir Novo Chamado
        </button>
      </section>

      <section className="table-responsive" role="region" aria-label="Lista dos meus chamados" tabIndex="0">
        {meusChamados.length === 0 ? (
          <div className="welcome-card">
            <div className="welcome-icon" aria-hidden="true">📋</div>
            <h2>Nenhum chamado aberto por você</h2>
            <p>Clique no botão acima para registrar um chamado de TI fornecendo seus dados de contato.</p>
          </div>
        ) : (
          <table className="custom-table" aria-label="Meus Chamados Abertos">
            <thead>
              <tr>
                <th scope="col">Protocolo</th>
                <th scope="col">Solicitante</th>
                <th scope="col">Contato</th>
                <th scope="col">Título / Categoria</th>
                <th scope="col">Data</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {meusChamados.map((item) => (
                <tr key={item.id || item.protocolo}>
                  <td><span className="protocol-badge">{item.protocolo}</span></td>
                  <td>{item.nomeVisitante}</td>
                  <td>{item.contatoVisitante}</td>
                  <td>
                    <div className="ticket-title-cell">
                      <strong>{item.titulo}</strong>
                      <span className="ticket-category">{item.categoria}</span>
                    </div>
                  </td>
                  <td>{item.dataAbertura ? new Date(item.dataAbertura).toLocaleDateString('pt-BR') : 'Hoje'}</td>
                  <td>
                    <span className={`badge-status status-${item.status?.toLowerCase()}`}>{item.status}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>

      {modalAberto && (
        <div 
          className="modal-backdrop"
          onClick={() => !carregando && setModalAberto(false)}
          role="dialog"
          aria-modal="true"
          aria-labelledby="modal-titulo"
        >
          <div className="modal-card" onClick={(e) => e.stopPropagation()}>
            <header className="modal-header">
              <h2 id="modal-titulo" style={{ fontSize: '1.25rem', margin: 0 }}>Abrir Chamado (Visitante)</h2>
              <button 
                className="btn-close" 
                onClick={() => setModalAberto(false)}
                aria-label="Fechar janela"
                disabled={carregando}
              >
                ×
              </button>
            </header>
            
            <form onSubmit={handleSubmitChamado} className="modal-form" noValidate>
              <h3 className="form-section-title">Dados Pessoais</h3>
              <div className="form-row">
                <div className="form-group">
                  <label htmlFor="nomeVisitante">Nome Completo *</label>
                  <input
                    id="nomeVisitante"
                    type="text"
                    value={nomeVisitante}
                    onChange={(e) => setNomeVisitante(e.target.value)}
                    placeholder="Seu nome"
                    required
                    aria-required="true"
                    disabled={carregando}
                  />
                </div>
                <div className="form-group">
                  <label htmlFor="contatoVisitante">Telefone / Contato *</label>
                  <input
                    id="contatoVisitante"
                    type="tel"
                    value={contatoVisitante}
                    onChange={handleContatoChange}
                    placeholder="(63) 99999-9999"
                    maxLength={15}
                    inputMode="numeric"
                    className={erroTelefone ? 'input-erro' : ''}
                    required
                    aria-required="true"
                    aria-invalid={!!erroTelefone}
                    aria-describedby={erroTelefone ? "erro-telefone-msg" : undefined}
                    disabled={carregando}
                  />
                  {erroTelefone && (
                    <span id="erro-telefone-msg" className="erro-campo" role="alert">{erroTelefone}</span>
                  )}
                </div>
              </div>

              <h3 className="form-section-title">Localização do Atendimento</h3>
              <div className="form-row">
                <div className="form-group">
                  <label htmlFor="secretariaId">Secretaria *</label>
                  <select 
                    id="secretariaId" 
                    value={secretariaId} 
                    onChange={(e) => setSecretariaId(e.target.value)} 
                    required 
                    aria-required="true"
                    disabled={carregando}
                  >
                    <option value="">Selecione a secretaria...</option>
                    {secretariasList.map((sec) => (
                      <option key={sec.id} value={sec.id}>{sec.nome} ({sec.sigla})</option>
                    ))}
                  </select>
                </div>
                <div className="form-group">
                  <label htmlFor="localId">Prédio / Unidade</label>
                  <select 
                    id="localId" 
                    value={localId} 
                    onChange={(e) => setLocalId(e.target.value)} 
                    disabled={!secretariaId || carregando}
                  >
                    <option value="">Selecione o local...</option>
                    {locaisList.map((loc) => (
                      <option key={loc.id} value={loc.id}>{loc.nome}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div className="form-group">
                <label htmlFor="localVisitante">Detalhamento do Local (Sala/Setor)</label>
                <input
                  id="localVisitante"
                  type="text"
                  value={localVisitante}
                  onChange={(e) => setLocalVisitante(e.target.value)}
                  placeholder="Ex: Sala 02, Recepção, Almoxarifado"
                  disabled={carregando}
                />
              </div>

              <h3 className="form-section-title">Dados da Solicitação</h3>
              <div className="form-row">
                <div className="form-group">
                  <label htmlFor="titulo">Título *</label>
                  <input
                    id="titulo"
                    type="text"
                    value={titulo}
                    onChange={(e) => setTitulo(e.target.value)}
                    placeholder="Resumo do problema"
                    required
                    aria-required="true"
                    disabled={carregando}
                  />
                </div>
                <div className="form-group">
                  <label htmlFor="categoria">Categoria *</label>
                  <select 
                    id="categoria" 
                    value={categoria} 
                    onChange={(e) => setCategoria(e.target.value)} 
                    required
                    aria-required="true"
                    disabled={carregando}
                  >
                    <option value="">Selecione a categoria...</option>
                    <option value="Hardware">Hardware (Computador, Impressora)</option>
                    <option value="Software">Software / Sistema</option>
                    <option value="Rede">Rede / Internet</option>
                    <option value="Outros">Outros</option>
                  </select>
                </div>
              </div>
              <div className="form-group">
                <label htmlFor="descricao">Descrição detalhada *</label>
                <textarea
                  id="descricao"
                  rows="3"
                  value={descricao}
                  onChange={(e) => setDescricao(e.target.value)}
                  placeholder="Descreva o problema com o máximo de detalhes possível"
                  required
                  aria-required="true"
                  disabled={carregando}
                />
              </div>

              <div className="modal-actions">
                <button 
                  type="button" 
                  className="btn-secondary" 
                  onClick={() => setModalAberto(false)}
                  disabled={carregando}
                >
                  Cancelar
                </button>
                <button 
                  type="submit" 
                  className="btn-primary-action" 
                  disabled={carregando}
                  aria-busy={carregando}
                >
                  {carregando ? 'A enviar...' : 'Enviar Chamado'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </main>
  );
}

export default DashboardVisitante;
</file>

