import React, { useEffect, useState } from 'react';
import { buscarMeusChamados } from '../../services/api';
import './DashboardUsuario.css';

export default function DashboardUsuario({ onLogout, onIrParaNovoChamado }) {
  const [chamados, setChamados] = useState([]);
  const [carregando, setCarregando] = useState(true);
  const [erro, setErro] = useState('');

  // Recupera os dados do usuário salvos no login
  const usuarioSalvo = JSON.parse(localStorage.getItem('usuario') || '{}');

  useEffect(() => {
    async function carregarDados() {
      try {
        const dados = await buscarMeusChamados();
        setChamados(dados);
      } catch (err) {
        setErro(err.message);
      } finally {
        setCarregando(false);
      }
    }
    carregarDados();
  }, []);

  return (
    <div className="dashboard-container">
      {/* Cabeçalho */}
      <header className="dashboard-header">
        <div className="user-welcome">
          <h2>Olá, {usuarioSalvo.nome || 'Usuário'}</h2>
          <p>Acompanhe o status dos seus chamados de TI</p>
        </div>
        <button onClick={onLogout} className="btn-sair">Sair</button>
      </header>

      {/* Ações Rápidas */}
      <section className="dashboard-actions">
        <button onClick={onIrParaNovoChamado} className="btn-novo-chamado">
          + Abrir Novo Chamado
        </button>
      </section>

      {/* Listagem de Chamados */}
      <section className="chamados-section">
        <h3>Meus Chamados</h3>

        {carregando && <p className="loading-text">Carregando chamados...</p>}
        {erro && <div className="error-message">{erro}</div>}

        {!carregando && !erro && chamados.length === 0 && (
          <p className="empty-text">Você ainda não abriu nenhum chamado.</p>
        )}

        {!carregando && chamados.length > 0 && (
          <div className="table-responsive">
            <table className="chamados-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Assunto / Descrição</th>
                  <th>Status</th>
                  <th>Data</th>
                </tr>
              </thead>
              <tbody>
                {chamados.map((chamado) => (
                  <tr key={chamado.id}>
                    <td>#{chamado.id}</td>
                    <td>{chamado.descricao}</td>
                    <td>
                      <span className={`badge-status status-${chamado.status?.toLowerCase()}`}>
                        {chamado.status}
                      </span>
                    </td>
                    <td>{new Date(chamado.dataAbertura).toLocaleDateString('pt-BR')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  );
}
